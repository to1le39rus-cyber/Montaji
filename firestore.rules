rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Original production contract: transparent Firebase anonymous auth.
    // Shared data is never migrated or deleted by these rules.
    function signedIn() {
      return request.auth != null;
    }

    match /appData/shared {
      allow read, write: if signedIn();
    }

    match /appData/notes {
      allow read, write: if signedIn();
    }

    // Sandbox-only notes v2 storage. Kept separate from legacy notes so the
    // new logic can be tested without touching the existing notes document.
    match /appData/notesV2 {
      allow read, write: if signedIn();
    }
  }
}
