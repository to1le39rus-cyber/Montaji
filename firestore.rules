rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOperator() {
      return signedIn() && request.auth.token.email in [
        'tkrp@bk.ru',
        'titoworld@bk.ru'
      ];
    }
    match /appData/shared {
      allow read, write: if signedIn() && isOperator();
    }
    match /appData/notes {
      allow read, write: if signedIn() && isOperator();
    }
    match /appData/canonicalWriteTest {
      allow read, write: if isOperator();
    }
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasUser() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() { return hasUser() ? myUser().role : null; }
    function myStoreId() { return hasUser() ? myUser().storeId : null; }
    function isManager() { return myRole() == 'manager'; }
    function isTeam() { return myRole() == 'installer' || myRole() == 'manager'; }
    function isStore() { return myRole() == 'store'; }
    function isActiveUser() { return hasUser() && myUser().active == true; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeam());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'pending';
      allow update: if isManager();
      allow delete: if false;
    }
    match /stores/{storeId} {
      allow read: if isTeam() || (isStore() && myStoreId() == storeId);
      allow write: if isManager();
    }
    match /jobs/{jobId} {
      allow read, create, update: if isActiveUser() && isTeam();
      allow delete: if false;
    }
    match /expenses/{expenseId} {
      allow read, create, update: if isActiveUser() && isTeam();
      allow delete: if false;
    }
    match /notes/{noteId} {
      allow read: if isActiveUser() && (
        isManager() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.visibility == 'public' && isTeam()) ||
        (resource.data.visibility == 'urgent' && isTeam()) ||
        (resource.data.visibility == 'urgent' && isStore()
          && resource.data.linkedStoreId == myStoreId())
      );
      allow create: if isActiveUser() && (isTeam() || isStore())
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActiveUser() && (
        isManager() ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.reassignedTo == request.auth.uid
      );
      allow delete: if false;
    }
    match /publicSlots/{slotId} {
      allow read: if isActiveUser() && (isTeam() || isStore());
      allow write: if isActiveUser() && isTeam();
    }
    match /bookingRequests/{id} {
      allow read: if isActiveUser() && (
        isTeam() || (isStore() && resource.data.storeId == myStoreId())
      );
      allow create: if isActiveUser() && isStore()
        && request.resource.data.storeId == myStoreId()
        && request.resource.data.status == 'pending';
      allow update: if isActiveUser() && isTeam();
      allow delete: if false;
    }
    function isOperatorAccount() { return isOperator(); }
    function memberPath(storeId) {
      return /databases/$(database)/documents/storeMemberships/$(storeId + '_' + request.auth.uid);
    }
    function isStoreMember(storeId) {
      return signedIn() && exists(memberPath(storeId))
        && get(memberPath(storeId)).data.active == true;
    }
    function isStoreAdmin(storeId) {
      return isStoreMember(storeId)
        && get(memberPath(storeId)).data.role == 'admin';
    }
    match /storeMemberships/{membershipId} {
      allow read: if signedIn() && (
        isOperatorAccount() ||
        resource.data.uid == request.auth.uid
      );
      allow create, update: if isOperatorAccount()
        || isStoreAdmin(request.resource.data.storeId);
      allow delete: if false;
    }
    match /storeRequests/{requestId} {
      allow read: if isOperatorAccount()
        || isStoreMember(resource.data.organizationId);
      allow create: if isStoreMember(request.resource.data.organizationId)
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.stage == 'installer_review';
      allow update: if isOperatorAccount()
        || (
          isStoreMember(resource.data.organizationId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.managerId == resource.data.managerId
        );
      allow delete: if false;
    }
    match /events/{eventId} {
      allow read: if signedIn() && (
        isOperatorAccount()
        || resource.data.recipientUid == request.auth.uid
        || (resource.data.organizationId != null && isStoreMember(resource.data.organizationId))
      );
      allow create: if isOperatorAccount()
        || (
          isStoreMember(request.resource.data.organizationId)
          && request.resource.data.actorUid == request.auth.uid
        );
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid;
      allow delete: if false;
    }
    match /controls/{id} {
      allow read, write: if isActiveUser() && isTeam();
    }
  }
}