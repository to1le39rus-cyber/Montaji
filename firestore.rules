rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep the production shared database available to authenticated users.
    // Email verification is handled by the UI, not by the database gate,
    // so an existing production session cannot lose access after a UI deploy.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /appData/shared {
      allow read, write: if signedIn();
    }

    match /appData/notes {
      allow read, write: if signedIn();
    }
  }
}
